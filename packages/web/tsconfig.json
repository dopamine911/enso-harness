{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist-types",
    // TS7 removed `baseUrl` (TS5102); a bare `paths` resolves relative to this file,
    // which is what the old baseUrl "." meant.
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": ".",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom", "bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../test-support"
    }
  ]
}
