{
  "name": "enso",
  "version": "0.0.0",
  "description": "A pi package: guarded tools, shared state, and two surfaces over one agent loop.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/logging/index.ts",
      "./extensions/guards/index.ts",
      "./extensions/web-fetch/index.ts",
      "./extensions/web-search/index.ts",
      "node_modules/@ladbabynpm/picc-permission-modes/index.ts",
      "node_modules/pi-multi-account/index.ts",
      "node_modules/@d3ara1n/pi-ask-user/src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes",
      "node_modules/@mammothb/pi-tokyonight-storm/themes"
    ]
  },
  "dependencies": {
    "@d3ara1n/pi-ask-user": "2.5.0",
    "@enso/core": "*",
    "@ladbabynpm/picc-permission-modes": "0.1.2",
    "@logtape/logtape": "2.3.7",
    "@mammothb/pi-tokyonight-storm": "0.2.1",
    "cc-safety-net": "2.4.6",
    "pi-multi-account": "1.23.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@logtape/testing": "2.3.7",
    "typebox": "^1.3.34"
  }
}
