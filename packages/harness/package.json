{
  "name": "enso",
  "version": "0.0.0",
  "private": true,
  "description": "A pi package: guarded tools, shared state, and two surfaces over one agent loop.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "core",
    "extensions",
    "prompts",
    "skills",
    "themes",
    "!**/__tests__"
  ],
  "pi": {
    "extensions": [
      "./extensions/logging/index.ts",
      "./extensions/guards/index.ts",
      "./extensions/web-fetch/index.ts",
      "./extensions/web-search/index.ts",
      "node_modules/@gotgenes/pi-permission-system/src/index.ts",
      "./extensions/permission-modes/index.ts",
      "node_modules/pi-multi-account/index.ts",
      "./extensions/ask-user/index.ts",
      "./extensions/system-prompt/index.ts",
      "./extensions/run-context/index.ts",
      "./extensions/incident-report/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes",
      "node_modules/@mammothb/pi-tokyonight-storm/themes"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-classifier": "npm:@earendil-works/pi-ai@1.1.0",
    "@enso/core": "*",
    "@gotgenes/pi-permission-system": "40.0.2",
    "@logtape/logtape": "2.3.7",
    "@mammothb/pi-tokyonight-storm": "0.2.1",
    "cc-safety-net": "2.4.6",
    "pi-multi-account": "1.24.0"
  },
  "bundledDependencies": [
    "@enso/core",
    "@gotgenes/pi-permission-system",
    "@mammothb/pi-tokyonight-storm",
    "pi-multi-account"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "~1.1.0",
    "@earendil-works/pi-coding-agent": "~1.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "~1.1.0",
    "@earendil-works/pi-coding-agent": "~1.1.0",
    "@logtape/testing": "2.3.7",
    "typebox": "^1.3.34"
  }
}
