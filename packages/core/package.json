{
  "name": "@enso/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Every TypeBox schema in Enso's product. One place, so a shape cannot be duplicated by accident.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./git": "./src/git.ts",
    "./judge": "./src/judge.ts",
    "./log-process": "./src/log-process.ts",
    "./loopback": "./src/loopback.ts",
    "./paths": "./src/paths.ts",
    "./permission-rules": "./src/permission-rules.ts",
    "./pi-manifest": "./src/pi-manifest.ts",
    "./process-marker": "./src/process-marker.ts",
    "./secrets": "./src/secrets.ts",
    "./snapshot-store": "./src/snapshot-store.ts",
    "./thread-tree": "./src/thread-tree.ts",
    "./flow-trace": "./src/__tests__/flow-trace.ts",
    "./log-recorder": "./src/__tests__/log-recorder.ts",
    "./observation-kinds": "./src/__tests__/observation-kinds.ts"
  },
  "dependencies": {
    "@logtape/file": "2.3.7",
    "@logtape/logtape": "2.3.7",
    "@logtape/pretty": "2.3.7",
    "@logtape/redaction": "2.3.7",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@logtape/testing": "2.3.7"
  }
}
