{
  "name": "@enso/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Every TypeBox schema in Enso's product. One place, so a shape cannot be duplicated by accident.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/__tests__",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./git": "./src/git.ts",
    "./judge": "./src/judge.ts",
    "./log-process": "./src/log-process.ts",
    "./loopback": "./src/loopback.ts",
    "./paths": "./src/paths.ts",
    "./permission-rules": "./src/permission-rules.ts",
    "./pi-manifest": "./src/pi-manifest.ts",
    "./process-marker": "./src/process-marker.ts",
    "./project-config": "./src/project-config.ts",
    "./secrets": "./src/secrets.ts",
    "./snapshot-store": "./src/snapshot-store.ts",
    "./thread-tree": "./src/thread-tree.ts",
    "./tree-setup": "./src/tree-setup.ts",
    "./user-config-write": "./src/user-config-write.ts",
    "./web-fetch-allowlist": "./src/web-fetch-allowlist.ts",
    "./web-search-settings": "./src/web-search-settings.ts"
  },
  "dependencies": {
    "@logtape/file": "2.3.7",
    "@logtape/logtape": "2.3.7",
    "@logtape/pretty": "2.3.7",
    "@logtape/redaction": "2.3.7",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@enso/test-support": "*",
    "typebox": "^1.3.34"
  },
  "peerDependencies": {
    "typebox": "*"
  }
}
