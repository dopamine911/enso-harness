{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-types",
      "!**/coverage",
      "!.claude",
      "!.biome",
      "!.inspiration",
      "!.local",
      "!.zen",
      "!.playwright-mcp",
      "!.codegraph",
      // Vendored upstream presentation — shadcn/ui primitives and the ai-elements port —
      // kept diffable against its registry/commit receipt rather than reformatted to our
      // style. This is ONE of three exclusions drawn at this path (the others are bunfig's
      // `coveragePathIgnorePatterns` and `.fallowrc.jsonc`'s `ignoreFindings`), and what
      // makes them defensible is `test/presentation-gate.test.ts`: since #253 it scans this
      // whole tree recursively, requires a provenance receipt per vendored subdirectory, and
      // refuses any import of the state layer. Widen this line and that gate widens with it;
      // narrow it and the files it uncovers must pass every rule above.
      "!packages/web/src/components"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noUselessTernary": "error",
        "noUselessTypeConstraint": "error",
        "noExcessiveNestedTestSuites": "error",
        "useSimplifiedLogicExpression": "error",
        "noImplicitCoercions": "error",
        "noUselessStringConcat": "error",
        "useMaxParams": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 25
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noUnknownAtRules": "error",
        "noTsIgnore": "error",
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error",
        "useAwait": "off"
      },
      "style": {
        "noNestedTernary": "error",
        "useNodejsImportProtocol": "off",
        "useNumericSeparators": "error",
        "useThrowOnlyError": "error",
        "noProcessEnv": "error",
        "useThrowNewError": "error",
        "noNonNullAssertion": "error",
        "useExplicitLengthCheck": "error"
      },
      "nursery": {
        "useSortedClasses": "error",
        "noFloatingPromises": "error",
        "useExhaustiveSwitchCases": "error",
        "useExplicitType": "error",
        "noConditionalExpect": "error",
        "noUselessTypeConversion": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "noImpliedEval": "error",
        "noUnmodifiedLoopCondition": "error",
        "noIdenticalTestTitle": "error",
        "useNullishCoalescing": "error",
        "noMisleadingReturnType": "error"
      },
      "performance": {
        "noReExportAll": "error"
      }
    },
    "domains": {
      "test": "all",
      "react": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": false
    }
  },
  "overrides": [
    // ── The environment boundary (#89) ────────────────────────────────────────
    // `noProcessEnv` cannot be satisfied by a program that has to read its own
    // environment: it flags `import { env } from 'node:process'` too, so there
    // is no spelling that a launcher, a log-level parser or a spawn can use.
    // The rule is therefore not switched off — it is scoped to a LIST, and this
    // list is the inventory of every place that touches the real environment.
    // A new file reading `process.env` fails the gate and has to argue its way
    // onto this list; everything else takes an injected environment, which is
    // also what makes the quarantine testable (#89) without a test ever reading
    // the machine it runs on.
    {
      "includes": [
        "scripts/zen.ts", // the launcher: quarantine, then the spawn's env
        "scripts/zen-thread.ts", // ZEN_SERVER_URL
        "scripts/zen-logs.ts", // ZEN_SERVER_URL, ZEN_LOGS_DIR
        "scripts/gate.ts", // npm_config_user_agent, and the child's FORCE_COLOR
        "packages/core/src/secrets.ts", // the quarantine's default argument — the seam itself
        "packages/harness/extensions/logging/index.ts", // the pi entry point's own environment
        "packages/web/src/host/agent-host.ts", // pins PI_CODING_AGENT_DIR, then quarantines
        "packages/web/src/server/dev.ts", // launcher: logs dir + levels
        "packages/web/src/server/dev-web.ts" // launcher: logs dir + levels
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      // ⚠ `site/src/content.config.ts` is excluded because its ONE object is Starlight's, not
      // ours: the collection must be keyed `docs` for `docsLoader()`/`docsSchema()` to find it
      // (@astrojs/starlight 0.42.2, #188), and the file declares nothing else. Excluded as a
      // FILE rather than by adding `docs` to `is_external_contract_key`, because that list is
      // keyed on the NAME and would exempt the word everywhere — three other files spell it,
      // and `test/naming-gate.test.ts` reported all three the moment it was tried.
      "includes": ["**", "!**/*.test.ts", "!**/*.test.tsx", "!site/src/content.config.ts"],
      "plugins": ["./.biome/naming.grit"]
    },

    // ── Cognitive-complexity exceptions (#82, #264) ───────────────────────────
    // The global ceiling above stays 25 ON PURPOSE: it is what keeps us from
    // writing functions a human cannot read. These entries do NOT relax it
    // globally and do NOT switch the rule off — each pins one file to the
    // EXACT score its worst function measures today, so the rule still fails
    // the moment that function grows. A number may go down, never up.
    //
    // Each exists because the complexity belongs to an EXTERNAL grammar or
    // protocol that must be read top-to-bottom, where extracting helpers would
    // scatter a state machine rather than simplify it. Replaces 7 per-line
    // `// biome-ignore` comments, which hid both the score and the count.
    // To retire one: reduce the function, then lower the number here AND its
    // row in `test/complexity-ratchet.test.ts`.
    //
    // ⚠ A ratchet nobody re-measures is not a ratchet — and an `overrides`
    // entry pins a FILE, so this file's number is also the ceiling for every
    // OTHER function in it. Hand-measuring caught the pins drifting (#82) but
    // not that slack: at #264 the three files below held 683 points of it, with
    // `literalShellWord` (50) free to reach 68 inside the tokenizer. The
    // re-measurement is therefore no longer a manual habit:
    // `test/complexity-ratchet.test.ts` runs Biome with this rule at 1 over
    // these three files on every `bun run check`, pins EVERY function above the
    // global ceiling by NAME at its measured score, and refuses a number here
    // that is higher than its own file's worst function.
    {
      // A shell character-scanner: `extractFlatShellCommandSegments` (68),
      // `literalShellWord` (50), `skipShellWord` (32). One linear read of the
      // quote/escape state machine, kept close to upstream oh-my-pi so a diff
      // stays reviewable — which is why it is not split into three files to
      // give each its own entry; the ratchet test holds the other two numbers.
      "includes": ["packages/harness/core/shell-segments.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 68 } }
          }
        }
      }
    },
    {
      // The `tool_call` guard dispatch (44): bash patch, then the write denials
      // in precedence order, then the reader gate. The precedence order IS the
      // security contract this file's header documents; splitting it hides it.
      "includes": ["packages/harness/extensions/guards/index.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 44 } }
          }
        }
      }
    },
    {
      // `mapPiEvent` (28): one switch arm per pi event type, read side-by-side
      // against pi's protocol doc. The complexity is the protocol's. Was 48 until
      // the `extension_ui_request` arm moved to `mapExtensionUiRequest` (#96), which
      // clears the default on its own; ratcheted down to the measured value.
      "includes": ["packages/web/src/host/map-events.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 28 } }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
