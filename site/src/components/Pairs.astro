---
/**
 * A ruled list of name → meaning rows, as the landing's factory list lays them out (the
 * `.factory-list` rules in `landing.css`). `highlightLast` marks the final row as the one the
 * others lead to.
 */
interface Props {
  rows: readonly (readonly [string, string])[]
  highlightLast?: boolean
}
const { rows, highlightLast = false } = Astro.props
---

<div class="factory-list">
  {
    rows.map(([name, meaning], index) => (
      <div class:list={['factory-item', { converge: highlightLast && index === rows.length - 1 }]}>
        <span>{name}</span>
        <strong>{meaning}</strong>
      </div>
    ))
  }
</div>
