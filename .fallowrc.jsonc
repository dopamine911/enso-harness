{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // fallow's static graph (#163, #162 workstream 8). Every entry below names a program whose
  // loader fallow cannot see; without it `fallow fix` would remove the guards. The four
  // extension entries are ASSERTED against `packages/harness/package.json` → `pi.extensions`
  // by `test/fallow-config.test.ts`, so the manifest and this list cannot drift apart.
  "entry": [
    // Loaded by the runtime from the harness manifest, never imported by our code.
    "packages/harness/extensions/logging/index.ts",
    "packages/harness/extensions/guards/index.ts",
    "packages/harness/extensions/web-fetch/index.ts",
    "packages/harness/extensions/web-search/index.ts",
    "packages/harness/extensions/ask-user/index.ts",
    "packages/harness/extensions/system-prompt/index.ts",
    "packages/harness/extensions/run-context/index.ts",
    "packages/harness/extensions/incident-report/index.ts",
    "packages/harness/extensions/permission-modes/index.ts",
    // Loaded by Bun from `packages/web/bunfig.toml` → `plugins`.
    "packages/web/src/server/bun-plugin-strict-binding-workaround.ts",
    // Run directly: `bun scripts/enso-thread.ts`; not a package.json script.
    "scripts/enso-thread.ts",
    // Spawned by `test/docs-gate.test.ts` and run by hand: `bun scripts/docs/<name>.ts`.
    "scripts/docs/*.ts",
    // Named by path in `site/astro.config.ts` (Starlight's `customCss` and `components`).
    "site/src/styles/theme.css",
    "site/src/components/LandingHero.astro"
  ],
  "ignoreDependencies": [
    // Loaded by the runtime from the harness manifest (`pi.extensions`, `pi.themes`).
    // `@gotgenes/pi-permission-system` is not here: the permission-modes extension imports it.
    "pi-multi-account",
    "@mammothb/pi-tokyonight-storm",
    // Loaded by Bun from `packages/web/bunfig.toml` → `plugins`, and by the dev server's HMR.
    "bun-plugin-tailwind",
    "react-refresh",
    // The runtime's own packages, supplied by it (peer `@earendil-works/pi-coding-agent`);
    // every import site is under the vendor gate's roots or on its allowlist (#145).
    "@earendil-works/pi-ai",
    "@earendil-works/pi-tui",
    // TypeScript 7's `tsc`, installed under an alias (#745): `typecheck` runs its binary, and
    // fallow credits a `tsc` script to the package named `typescript` — here the 6.0 API alias.
    // `test/dependency-gate.test.ts` checks `node_modules/.bin/tsc` resolves to this package.
    "@typescript/native",
    // The page's fonts, served as FILES by `packages/web/src/server/font-files.ts` and linked by
    // `fonts.ts` — never imported, because Bun inlines every font a bundled stylesheet names
    // (#407). `test/fallow-config.test.ts` holds this list equal to the web package's @fontsource
    // dependencies, and `fonts.test.ts` holds those equal to what the page links.
    "@fontsource-variable/fraunces",
    "@fontsource-variable/geist",
    "@fontsource-variable/ibm-plex-sans",
    "@fontsource-variable/inter",
    "@fontsource-variable/jetbrains-mono",
    "@fontsource-variable/sora",
    "@fontsource-variable/source-sans-3",
    "@fontsource-variable/space-grotesk",
    "@fontsource/ibm-plex-mono"
  ],
  "ignorePatterns": [".inspiration/**", ".local/**", ".enso/**", "dist-types/**"],
  // The landing page's feature map is BUILD OUTPUT (#504): `scripts/docs/site-content.ts` writes it
  // before every site build, and it is gitignored, so an audit of a fresh checkout cannot resolve
  // it. The one specifier by name, never `../generated/**`: another missing file must still show.
  "ignoreUnresolvedImports": ["../generated/landing-features.json"],
  // "Every shape is a schema in @enso/core" (architecture → The shared core) emits a `Static<typeof X>`
  // type for every schema whether or not code names the type; the unnamed ones are still the
  // contract's public surface, not dead code (#175 bucket C). BY NAME, never "*": a genuinely
  // unused core export must still show. A schema whose type gains a consumer leaves this list.
  "ignoreExports": [
    { "file": "packages/core/src/dialog.ts", "exports": ["EnsoDialogAnswer"] },
    { "file": "packages/core/src/follow.ts", "exports": ["EnsoFollowObservation"] },
    {
      "file": "packages/core/src/observation.ts",
      "exports": [
        "EnsoCustomEntry",
        "EnsoDialogSettled",
        "EnsoMessageEnd",
        "EnsoMessageStart",
        "EnsoPermissionMode",
        "EnsoPermissionModeRejected",
        "EnsoPromptRejected",
        "EnsoQueue",
        "EnsoSessionUsageObservation",
        "EnsoTurnEnd",
        "EnsoTurnStart"
      ]
    },
    { "file": "packages/core/src/tool-result.ts", "exports": ["EnsoTruncation", "EnsoTruncationUnit"] },
    {
      "file": "packages/core/src/transcript.ts",
      "exports": ["EnsoTranscriptCustom", "EnsoTranscriptMessage", "EnsoTranscriptOther", "EnsoTranscriptToolResult"]
    },
    { "file": "packages/core/src/web-fetch.ts", "exports": ["WebFetchConfig"] },
    { "file": "packages/core/src/web-search.ts", "exports": ["WebSearchToolParameters"] }
  ],
  // Vendored presentation and shadcn primitives stay IN the graph (their dependencies are real)
  // but their own findings are hidden: the linter and coverage already exclude them (#31, #121), and
  // an unused sub-component there is upstream's, kept diffable, not ours to prune.
  "ignoreFindings": ["packages/web/src/components/**"],
  // Clone detection (#174). `semantic` is the mode this repo reads: `mild` (the default) found
  // three groups and 0.29 % by tokens; the same structure under renamed identifiers is 51
  // groups, and that is the repeated shape, so that is the number the baseline holds. Four
  // classes are excluded by decision, each with its reason:
  // - the vendored components, for the reason `ignoreFindings` gives above — dupes has its own
  //   ignore list, so the decision is written twice;
  // - `@enso/core`'s DECLARATION modules, BY NAME (#827): "every shape is a schema" (architecture →
  //   The shared core) emits a `Type.Object` + `Static` pair per schema on purpose, most with a
  //   validated reader beside it, and the tool pairs those as clones. The convention IS the
  //   repetition. A file is listed when it declares and does nothing else — schemas, their types,
  //   the reader or guard over each, the constants they enumerate — and leaves the list when it
  //   gains logic. A core module WITH logic stays counted whole, its schemas too (`session-risk.ts`,
  //   `session-incident.ts`, `log-stats.ts`, `follow.ts`, …): excluding it would hide its logic's
  //   clones, which is what the old `packages/core/src/**` did, and a line suppression would sit
  //   inside a schema literal at a token offset that moves with every edit above it.
  // - `packages/web/src/styles/themes.css`: a colour theme IS the full set of shadcn variables, so
  //   every palette block names the same variables with its own values — the tool pairs the names.
  //   Nothing is shared to fold: a theme that borrowed another's values would be the drift
  //   `__tests__/theme.test.ts` checks for (every theme defines every variable).
  // - `scripts/docs/inventory/`: the doc generators' checked metadata tables (#593) — one row per
  //   finding a detector makes, every row the same shape with different words. The tool pairs
  //   uniform rows as clones and there is nothing to fold: a row that borrowed another's fields
  //   would be wrong. Until #593 these rows stayed in the count, and they were most of what it
  //   measured (`env-and-config.ts`'s three tables alone: 364 of 1,740 lines). By DIRECTORY, so
  //   a generator's logic stays counted: only tables live there, which that directory's modules say.
  // What stays in the count and is NOT excluded: Playwright arrange/act blocks, the dispatcher's
  // route branches, a table still inline in a generator. `threshold` is the ratchet: fallow 3.25's
  // regression baseline carries dead-code categories only, so the duplicated-line percentage is
  // the number that can only fall while the measured tree stays the same. Lower it when a fold
  // lands; raise it only when an exclusion narrows and more of the tree is measured (#827), never
  // for code added. Read by the blocking `duplication` step of `scripts/gate.ts` (`dupes:check`)
  // since #593.
  //
  // ⚠ A ratchet that is red before any PR touches it reports nothing — every PR sees the same
  // red, so a genuine increase is indistinguishable from the standing state (#260). The 4.5
  // pinned on #174 was crossed without anyone being told, because the step is advisory.
  // Measured 2026-09-18 by bisecting `bunx fallow dupes --threshold`: 4.515141576473161 % at
  // `d13f109` (826 duplicated lines of 18294), so the pin moved to 4.52. #336 (the debug
  // surface) then took it to 4.7 % unseen, and `main` sat at 4.79 % (1217 of 25411) until #352
  // folded the two tail pages onto `debug/log-tail-view.tsx` and the day-stats spend columns
  // onto one list: 3.5577944822700616 % (904 of 25409). 3.56 is the two-decimal value that
  // passes it. #45 phase 2 then went to 3.9 % (1024) before it folded: the stats drawer's fetch
  // onto `route-read.ts` with the timeline's, its charts' axes onto one `turnAxes`, its select and
  // the log level's onto `option-select.tsx`, `core-exports.ts`'s two module maps onto one table,
  // and `routes.ts`'s six thread reads onto `threadRead` — 3.040667518604826 % (809 of 26606),
  // pinned at 3.05. `main` then drifted down to ~2.77 % with the pin left behind; the colour
  // themes' palette file joined the exclusions above (it also took the old Kanagawa Lotus/Wave
  // pair out of the count — an exclusion, not a fold): 2.5538522532047048 % (773 of 30268),
  // pinned at 2.56. Adding four theme families folded `theme.ts`'s table into family → id →
  // label (a row per theme restating its family and scheme was a clone group of its own):
  // 2.5472040069858632 % (773 of 30347), pinned at 2.55. `main` had drifted back up to 3.0 % and #452
  // added its routes; the server's route table (a `threadRoute` builder, compact rows), its JSON control
  // routes (one `answerControl`), `follow.ts`'s lease and refusal types, and the routes page's metadata
  // (positional rows, paths derived) were folded: 2.509718172983479 % (1,033 of 41,160), pinned at
  // 2.52. `main` then crossed it unseen again: 2.7137888547499105 % (1,740 of 64,095) on
  // 2026-10-05, up from 2.51 % at `777f985` six days earlier. #593 moved the generators' tables
  // into `scripts/docs/inventory/` (an exclusion, not a fold, as the themes' was):
  // 2.433242806235381 % (1,550 of 63,701), pinned at 2.44. `main` then drifted down to
  // 2.28797347277133 % (1,794 of 78,410) with the pin left behind. #827 narrowed the core
  // exclusion from all of `packages/core/src/**` to its twelve declaration modules: core counted
  // whole was 4.01 % (3,891 of 96,930, 61 more clone groups); by name, 2.73 % (2,562 of 93,872).
  // The logic clones that surfaced were folded — git's three runners onto `execGit`, three log
  // line loops onto `parseEnsoLogText`, the log's and the judge's secret alternation onto
  // `secretValuePattern`, the host's stored mode onto `recordedPermissionMode`, the snapshot
  // store's two tree listings onto `listTree`: 2.6403800272665303 % (2,479 of 93,888), pinned at
  // 2.65. The number ROSE because an exclusion narrowed, not because code was added: core's logic
  // modules, and the schemas inside them, are measured now. Re-measure with
  // `bunx fallow dupes --format json` (`stats.duplication_percentage`), and lower it the moment
  // a fold makes a smaller number pass.
  //
  // PROMOTED to a blocking gate step (#593). The condition this comment used to set — "red for a
  // real regression once" — had been met four times over (4.79, 3.9, 3.0, 2.71), each crossing
  // landing unseen because the step was advisory and already red. Blocking is what makes the
  // next crossing the commit that causes it, not a number found weeks later.
  "duplicates": {
    "mode": "semantic",
    "ignore": [
      "packages/web/src/components/**",
      "packages/core/src/git-state.ts",
      "packages/core/src/guard.ts",
      "packages/core/src/observation.ts",
      "packages/core/src/permission-mode.ts",
      "packages/core/src/project-settings.ts",
      "packages/core/src/run-context.ts",
      "packages/core/src/thread-context.ts",
      "packages/core/src/thread-runtime.ts",
      "packages/core/src/thread-stats.ts",
      "packages/core/src/thread-tree-record.ts",
      "packages/core/src/tool-result.ts",
      "packages/core/src/ui-events.ts",
      "packages/web/src/styles/themes.css",
      "scripts/docs/inventory/**"
    ],
    "threshold": 2.65
  },
  // Complexity. Two gate steps read this block, both blocking:
  //
  //   • the CEILING (`complexity`, `complexity:check`): `fallow health` over EVERY function at a
  //     cognitive ceiling of 20 — 25 until #595, which reduced eight of the nine functions between
  //     the two and pinned the ninth — the ceiling that keeps us from writing functions a human
  //     cannot read, with the per-function pins below as its only exceptions;
  //   • NEW CODE (`new-complexity`, `complexity:new`, #594): the same over every function at 15
  //     (fallow's own default), against `complexity-baseline.json`, an identity baseline (file +
  //     function name) of the functions already over 15 when it was taken (46 at #594, 39 after
  //     #595). A function not in it — new, or renamed — must be under 15; one in it is held by the
  //     ceiling instead. The list only shrinks: a listed function that
  //     no longer needs its entry fails — fallow's `--fail-on-stale-baseline` catches a FILE with no
  //     finding left, and `test/complexity-ratchet.test.ts` catches the single function (measured on
  //     #594: fallow alone passed a stale entry in a file with other findings). Re-save with
  //     `bun run complexity:baseline` to drop it. A re-save that ADDS an entry is an exception,
  //     reviewed as one.
  //
  // Both gate cognitive only (`--max-cyclomatic` is lifted). CRAP (cyclomatic² × (1 − coverage)³ +
  // cyclomatic) stays OFF here (`maxCrap: 0`) and is a step of its own, `crap` (#826, #844): Bun's
  // LCOV has no function spans, so these two steps could only score fallow's ESTIMATE, which flagged
  // functions the suite drives (#180, #181, #182); and CRAP on in this config turns the baselined
  // function's finding into `cognitive_crap`, which fails the new-complexity step. The `crap` step
  // runs after `test`, converts the LCOV with `scripts/coverage-istanbul.ts`, and fails on CRAP ≥ 30
  // from MEASURED coverage outside `crap-pins.json` (`scripts/check-crap.ts`). Its pins are not
  // `thresholdOverrides` below: with CRAP off here, these steps would list each as `no_match`.
  // ⚠ fallow reads `coverage/coverage-final.json` by itself when it exists, so a hand-run
  // `--max-crap` scores from the last map written.
  //
  // `thresholdOverrides` are the exceptions to the gate's ceiling, pinned per FUNCTION at the
  // exact score it measures today, so the rule still fails the moment that function grows. A
  // number may go down, never up. Each exists because the function holds an order that must be
  // read top-to-bottom, where extracting helpers would hide it rather than simplify it; its
  // `reason` says why that order cannot be split (#814). To retire one: reduce the function, then
  // lower (or delete) its entry. `test/complexity-ratchet.test.ts` refuses an entry that is looser
  // than its function's score, names a function that no longer exists, or pins one already under
  // the ceiling.
  //
  // `ignore`: the vendored components, for the reason `ignoreFindings` gives above — their
  // functions are upstream's, kept diffable (the shadcn `chart.tsx` #45 fetched arrived with a
  // 22-branch tooltip formatter fallow then called ours).
  "health": {
    "maxCrap": 0,
    "ignore": ["packages/web/src/components/**"],
    "thresholdOverrides": [
      {
        "files": ["packages/harness/core/guard-session.ts"],
        "functions": ["decide"],
        "maxCognitive": 22,
        "reason": "The tool_call guard dispatch: the standing denials (floor, incident suspension — standingDenial), the shell denies, then the write denials in precedence order, then the reader gate (readerDenial, last). The precedence order IS the security contract the module header documents; splitting it hides it. The bash timeout patch left it for toolCall (#861)."
      }
    ]
  },
  // The dead-code rules that can fire in this repository are `error` (#594), so a finding fails the
  // gate outright — and there is no baseline since #594, so nothing can be accepted by re-saving one.
  // Rules for stacks it does not use (Vue, Svelte, Pinia, server actions) and the CSS analytics keep
  // fallow's defaults. The five promoted from `warn` had no finding when they were promoted.
  // `boundary-violation` has been `error` since the day-one list (five, all `rpc/`, recorded on
  // #173) reached zero; coverage and forbidden-call findings share its severity. `policy-violation`
  // is OFF: it reads rule packs, and none are configured — on, it printed a "nothing was measured"
  // diagnostic on every run.
  "rules": {
    "boundary-violation": "error",
    "unused-dev-dependencies": "error",
    "re-export-cycle": "error",
    "test-only-dependencies": "error",
    "type-only-dependencies": "error",
    "stale-suppressions": "error",
    "policy-violation": "off"
  },
  // Architecture boundaries (#173, #162 workstream 9): the vendor gate and the storage seam read
  // TEXT; this reads the IMPORT GRAPH, and catches what text cannot — a re-export chain, a
  // type-only import, a barrel that leaks a zone. Zones are the TARGET layout of the re-cut,
  // written before the tree matches it; the violation list is the move list. What it cannot say:
  // a zone is a directory glob, so "may import the runtime" (an npm package) stays the vendor
  // gate's text scan. `allowTypeOnly` is deliberately absent: a type-only crossing is still a
  // dependency (#145's rule).
  "boundaries": {
    "zones": [
      // Each package's tests are a zone of their own, listed BEFORE the package's zone (a file is
      // in the first zone that matches): a test may import exactly what the code it tests may,
      // plus `test-support` — and production code still may not (#951).
      { "name": "core-tests", "patterns": ["packages/core/src/__tests__/**"] },
      { "name": "core", "patterns": ["packages/core/src/**"] },
      { "name": "test-support", "patterns": ["packages/test-support/**"] },
      { "name": "harness-core", "patterns": ["packages/harness/core/**"] },
      { "name": "judge-backends", "patterns": ["packages/harness/extensions/guards/judge-backends.ts"] },
      { "name": "harness-extension-tests", "patterns": ["packages/harness/extensions/**/__tests__/**"] },
      { "name": "harness-extensions", "patterns": ["packages/harness/extensions/**"] },
      { "name": "host-tests", "patterns": ["packages/web/src/host/**/__tests__/**"] },
      { "name": "server-tests", "patterns": ["packages/web/src/server/**/__tests__/**"] },
      { "name": "browser-tests", "patterns": ["packages/web/src/**/__tests__/**"] },
      { "name": "host", "patterns": ["packages/web/src/host/**"] },
      { "name": "server", "patterns": ["packages/web/src/server/**"] },
      { "name": "browser", "patterns": ["packages/web/src/**"] },
      { "name": "site-base", "patterns": ["scripts/docs/site-base.ts"] },
      { "name": "corpus-shapes", "patterns": ["scripts/corpus-shapes.ts"] },
      { "name": "scripts-tests", "patterns": ["scripts/__tests__/**"] },
      { "name": "scripts", "patterns": ["scripts/**"] },
      { "name": "test", "patterns": ["test/**", "packages/web/e2e/**"] },
      { "name": "site", "patterns": ["site/**"] }
    ],
    "rules": [
      { "from": "core-tests", "allow": ["core", "test-support"] },
      { "from": "core", "allow": [] },
      // The tests' shared helpers (#951): built on core, imported only from test zones.
      { "from": "test-support", "allow": ["core"] },
      { "from": "harness-core", "allow": ["core"] },
      {
        "from": "harness-extension-tests",
        "allow": ["harness-extensions", "core", "harness-core", "judge-backends", "test-support"]
      },
      { "from": "harness-extensions", "allow": ["core", "harness-core", "judge-backends"] },
      { "from": "host-tests", "allow": ["host", "core", "test-support"] },
      { "from": "host", "allow": ["core"] },
      { "from": "server-tests", "allow": ["server", "core", "host", "test-support"] },
      { "from": "server", "allow": ["core", "host"] },
      { "from": "browser-tests", "allow": ["browser", "core", "test-support"] },
      { "from": "browser", "allow": ["core"] },
      // The command judge's backends (#535) are their own one-file zone, as `site-base` is: they
      // must sit where pi's libraries may be named (the vendor gate's roots), and `bun run judge`
      // must replay with exactly the guard's backends. So `scripts` may reach this ONE file, which
      // may itself reach only `core` — never the rest of the harness.
      {
        "from": "scripts-tests",
        "allow": ["scripts", "core", "site-base", "judge-backends", "corpus-shapes", "test-support"]
      },
      { "from": "scripts", "allow": ["core", "site-base", "judge-backends", "corpus-shapes"] },
      { "from": "judge-backends", "allow": ["core"] },
      // The transcript corpus report (#534) measures the shapes the GUARD sees, so its reader
      // must segment with the guard's own segmenter (`harness-core`). Same pattern: one file
      // `scripts` may reach, which reaches `core` and `harness-core` and nothing else.
      { "from": "corpus-shapes", "allow": ["core", "harness-core"] },
      // The site is presentation over generated output: it renders Astro and Starlight, and its
      // CONTENT arrives as files `scripts/docs/site-content.ts` writes, never as an import. It
      // may read ONE file — the base path the site is served under, which the projector, the
      // link crawl and Astro must agree on to the character. Three literals would agree until
      // the day it is published elsewhere and then disagree silently: a wrong base yields
      // working HTML whose every link 404s, and a crawl carrying the same wrong literal reports
      // green over it. One import beats a gate comparing two strings.
      //
      // ⚠ THAT FILE IS ITS OWN ZONE, so the permission is the sentence (PR #330 review). Naming
      // `scripts` here would have allowed the site to import any script in the repository while
      // the comment claimed otherwise — a boundary enforced by convention is not a boundary.
      // `site-base` is a one-file zone that may itself import nothing, and `site` may reach only
      // it; `core` stays refused either way — a renderer with opinions about contracts.
      { "from": "site", "allow": ["site-base"] },
      { "from": "site-base", "allow": [] },
      {
        "from": "test",
        "allow": [
          "core",
          "harness-core",
          "harness-extensions",
          "judge-backends",
          "host",
          // The e2e home seeds a stored session with the host tests' own writer.
          "host-tests",
          "server",
          "browser",
          "scripts",
          "corpus-shapes"
        ]
      }
    ],
    // Both HTML entries: an `.html` is the bundler's entry, not a module in any zone. The chat
    // page and the debug page (#144 slice 2) are the two, and naming each keeps a third from
    // arriving unremarked. `oxlint.config.ts` is the lint tool's config, loaded by oxlint and by
    // nothing in the program; it reads its lists from `scripts/lint/`, where the tests and doc
    // generators that hold them also read them.
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": ["packages/web/index.html", "packages/web/debug.html", "oxlint.config.ts"]
    },
    // The storage seam (`no-duplicate-paths`): one file constructs the session manager.
    "calls": {
      "forbidden": [
        { "from": "server", "callee": "SessionManager.*" },
        { "from": "browser", "callee": "SessionManager.*" }
      ]
    }
  }
}
