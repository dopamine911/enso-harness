{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // fallow's static graph (#163, #162 workstream 8). Every entry below names a program whose
  // loader fallow cannot see; without it `fallow fix` would remove the guards. The four
  // extension entries are ASSERTED against `packages/harness/package.json` → `pi.extensions`
  // by `test/fallow-config.test.ts`, so the manifest and this list cannot drift apart.
  "entry": [
    // Loaded by the runtime from the harness manifest, never imported by our code.
    "packages/harness/extensions/logging/index.ts",
    "packages/harness/extensions/guards/index.ts",
    "packages/harness/extensions/web-fetch/index.ts",
    "packages/harness/extensions/web-search/index.ts",
    "packages/harness/extensions/ask-user/index.ts",
    "packages/harness/extensions/run-context/index.ts",
    // Loaded by Bun from `packages/web/bunfig.toml` → `plugins`.
    "packages/web/src/server/bun-plugin-strict-binding-workaround.ts",
    // Run directly: `bun scripts/enso-thread.ts`; not a package.json script.
    "scripts/enso-thread.ts",
    // Spawned by `test/docs-gate.test.ts` and run by hand: `bun scripts/docs/<name>.ts`.
    "scripts/docs/*.ts"
  ],
  "ignoreDependencies": [
    // Loaded by the runtime from the harness manifest (`pi.extensions`, `pi.themes`).
    "@ladbabynpm/picc-permission-modes",
    "pi-multi-account",
    "@mammothb/pi-tokyonight-storm",
    // Loaded by Bun from `packages/web/bunfig.toml` → `plugins`, and by the dev server's HMR.
    "bun-plugin-tailwind",
    "react-refresh",
    // The runtime's own packages, supplied by it (peer `@earendil-works/pi-coding-agent`);
    // every import site is under the vendor gate's roots or on its allowlist (#145).
    "@earendil-works/pi-ai",
    "@earendil-works/pi-tui",
    // The page's fonts, served as FILES by `packages/web/src/server/font-files.ts` and linked by
    // `fonts.ts` — never imported, because Bun inlines every font a bundled stylesheet names
    // (#407). `test/fallow-config.test.ts` holds this list equal to the web package's @fontsource
    // dependencies, and `fonts.test.ts` holds those equal to what the page links.
    "@fontsource-variable/fraunces",
    "@fontsource-variable/geist",
    "@fontsource-variable/ibm-plex-sans",
    "@fontsource-variable/inter",
    "@fontsource-variable/jetbrains-mono",
    "@fontsource-variable/sora",
    "@fontsource-variable/source-sans-3",
    "@fontsource-variable/space-grotesk",
    "@fontsource/ibm-plex-mono"
  ],
  "ignorePatterns": [".inspiration/**", ".local/**", ".enso/**", "dist-types/**"],
  // "Every shape is a schema in @enso/core" (architecture → The shared core) emits a `Static<typeof X>`
  // type for every schema whether or not code names the type; the unnamed ones are still the
  // contract's public surface, not dead code (#175 bucket C). BY NAME, never "*": a genuinely
  // unused core export must still show. A schema whose type gains a consumer leaves this list.
  "ignoreExports": [
    { "file": "packages/core/src/dialog.ts", "exports": ["EnsoDialogAnswer"] },
    { "file": "packages/core/src/follow.ts", "exports": ["EnsoFollowObservation"] },
    {
      "file": "packages/core/src/observation.ts",
      "exports": [
        "EnsoCustomEntry",
        "EnsoDialogSettled",
        "EnsoMessageEnd",
        "EnsoMessageStart",
        "EnsoPermissionMode",
        "EnsoPermissionModeRejected",
        "EnsoPromptRejected",
        "EnsoQueue",
        "EnsoSessionUsageObservation",
        "EnsoTurnEnd",
        "EnsoTurnStart"
      ]
    },
    { "file": "packages/core/src/tool-result.ts", "exports": ["EnsoTruncation", "EnsoTruncationUnit"] },
    {
      "file": "packages/core/src/transcript.ts",
      "exports": ["EnsoTranscriptCustom", "EnsoTranscriptMessage", "EnsoTranscriptOther", "EnsoTranscriptToolResult"]
    },
    { "file": "packages/core/src/web-fetch.ts", "exports": ["WebFetchConfig"] },
    { "file": "packages/core/src/web-search.ts", "exports": ["WebSearchToolParameters"] }
  ],
  // Vendored presentation and shadcn primitives stay IN the graph (their dependencies are real)
  // but their own findings are hidden: the linter and coverage already exclude them (#31, #121), and
  // an unused sub-component there is upstream's, kept diffable, not ours to prune.
  "ignoreFindings": ["packages/web/src/components/**"],
  // Clone detection (#174). `semantic` is the mode this repo reads: `mild` (the default) found
  // three groups and 0.29 % by tokens; the same structure under renamed identifiers is 51
  // groups, and that is the repeated shape, so that is the number the baseline holds. Two
  // classes are excluded by decision, each with its reason:
  // - the vendored components, for the reason `ignoreFindings` gives above — dupes has its own
  //   ignore list, so the decision is written twice;
  // - `@enso/core`: "every shape is a schema" (architecture → The shared core) emits a
  //   `Type.Object` + `Static` pair per schema on purpose, and the tool pairs those as clones.
  //   The convention IS the repetition; a real clone in core is found by the reviewer, not here.
  // - `packages/web/src/styles/themes.css`: a colour theme IS the full set of shadcn variables, so
  //   every palette block names the same variables with its own values — the tool pairs the names.
  //   Nothing is shared to fold: a theme that borrowed another's values would be the drift
  //   `__tests__/theme.test.ts` checks for (every theme defines every variable).
  // What stays in the count and is NOT excluded: consecutive metadata rows in the generators,
  // Playwright arrange/act blocks, the dispatcher's route branches — inventory. `threshold` is
  // the ratchet: fallow 3.25's regression baseline carries dead-code categories only, so the
  // duplicated-line percentage is the number that can only fall. Lower it when a fold lands,
  // never raise it. Read by the advisory `fallow-audit` job (`.github/workflows/ci.yml`).
  //
  // ⚠ A ratchet that is red before any PR touches it reports nothing — every PR sees the same
  // red, so a genuine increase is indistinguishable from the standing state (#260). The 4.5
  // pinned on #174 was crossed without anyone being told, because the step is advisory.
  // Measured 2026-09-18 by bisecting `bunx fallow dupes --threshold`: 4.515141576473161 % at
  // `d13f109` (826 duplicated lines of 18294), so the pin moved to 4.52. #336 (the debug
  // surface) then took it to 4.7 % unseen, and `main` sat at 4.79 % (1217 of 25411) until #352
  // folded the two tail pages onto `debug/log-tail-view.tsx` and the day-stats spend columns
  // onto one list: 3.5577944822700616 % (904 of 25409). 3.56 is the two-decimal value that
  // passes it. #45 phase 2 then went to 3.9 % (1024) before it folded: the stats drawer's fetch
  // onto `route-read.ts` with the timeline's, its charts' axes onto one `turnAxes`, its select and
  // the log level's onto `option-select.tsx`, `core-exports.ts`'s two module maps onto one table,
  // and `routes.ts`'s six thread reads onto `threadRead` — 3.040667518604826 % (809 of 26606),
  // pinned at 3.05. `main` then drifted down to ~2.77 % with the pin left behind; the colour
  // themes' palette file joined the exclusions above (it also took the old Kanagawa Lotus/Wave
  // pair out of the count — an exclusion, not a fold): 2.5538522532047048 % (773 of 30268),
  // pinned at 2.56. Adding four theme families folded `theme.ts`'s table into family → id →
  // label (a row per theme restating its family and scheme was a clone group of its own):
  // 2.5472040069858632 % (773 of 30347), pinned at 2.55. Re-measure with
  // `bunx fallow dupes --format json` (`stats.duplication_percentage`), and lower it the moment
  // a fold makes a smaller number pass.
  //
  // Still advisory, not promoted: the promotion condition this comment has always stated —
  // "red for a real regression once" — cannot have been met while the ratchet was red for a
  // stale pin instead. Re-pinning is what makes the first real crossing observable; promote
  // after one.
  "duplicates": {
    "mode": "semantic",
    "ignore": ["packages/web/src/components/**", "packages/core/src/**", "packages/web/src/styles/themes.css"],
    "threshold": 2.55
  },
  // Complexity. Two readers of this block:
  //
  //   • `fallow audit` (the advisory job) applies these thresholds to CHANGED functions. CRAP is
  //     OFF, not raised: it is cyclomatic × (1 − coverage)³, and fallow can only ESTIMATE coverage
  //     here — Bun's LCOV has no function spans for `--coverage`, so every score is
  //     `coverage_source: estimated`, and the estimate reads from export references, which a
  //     request listener or a generator's `generate()` never has. Every complexity finding the
  //     audit raised on #180, #181 and #182 was `exceeded: crap` on a function the suite drives;
  //     cyclomatic (20) and cognitive (15) are fallow's defaults and stay advisory.
  //   • The `complexity` gate (scripts/gate.ts → `complexity:check`) runs `fallow health` over
  //     EVERY function at a cognitive ceiling of 25 — the ceiling that keeps us from writing
  //     functions a human cannot read. It gates cognitive only (`--max-cyclomatic` is lifted
  //     there); cyclomatic stays the audit's advisory signal, as it has always been.
  //
  // `thresholdOverrides` are the exceptions to the gate's ceiling, pinned per FUNCTION at the
  // exact score it measures today, so the rule still fails the moment that function grows. A
  // number may go down, never up. Each exists because the complexity belongs to an EXTERNAL
  // grammar or protocol that must be read top-to-bottom, where extracting helpers would scatter
  // a state machine rather than simplify it. To retire one: reduce the function, then lower (or
  // delete) its entry. `test/complexity-ratchet.test.ts` refuses an entry that is looser than
  // its function's score, names a function that no longer exists, or pins one already under 25.
  //
  // `ignore`: the vendored components, for the reason `ignoreFindings` gives above — their
  // functions are upstream's, kept diffable (the shadcn `chart.tsx` #45 fetched arrived with a
  // 22-branch tooltip formatter the audit then called ours).
  "health": {
    "maxCrap": 0,
    "ignore": ["packages/web/src/components/**"],
    "thresholdOverrides": [
      {
        "files": ["packages/harness/core/shell-segments.ts"],
        "functions": ["extractFlatShellCommandSegments"],
        "maxCognitive": 68,
        "reason": "The shell character-scanner: one linear read of the quote/escape state machine, kept close to upstream oh-my-pi so a diff stays reviewable."
      },
      {
        "files": ["packages/harness/core/shell-segments.ts"],
        "functions": ["literalShellWord"],
        "maxCognitive": 50,
        "reason": "Same scanner: the quoted-word reader."
      },
      {
        "files": ["packages/harness/core/shell-segments.ts"],
        "functions": ["skipShellWord"],
        "maxCognitive": 32,
        "reason": "Same scanner: the word skipper."
      },
      {
        "files": ["packages/harness/extensions/guards/index.ts"],
        "functions": ["decide"],
        "maxCognitive": 27,
        "reason": "The tool_call guard dispatch: bash patch, then the write denials in precedence order, then the reader gate (readerDenial, last). The precedence order IS the security contract the file header documents; splitting it hides it."
      }
    ]
  },
  // `error` since the day-one list (five, all `rpc/`, recorded on #173) reached zero: a crossing
  // now fails the dead-code gate step. Coverage and forbidden-call findings share the severity.
  "rules": { "boundary-violation": "error" },
  // Architecture boundaries (#173, #162 workstream 9): the vendor gate and the storage seam read
  // TEXT; this reads the IMPORT GRAPH, and catches what text cannot — a re-export chain, a
  // type-only import, a barrel that leaks a zone. Zones are the TARGET layout of the re-cut,
  // written before the tree matches it; the violation list is the move list. What it cannot say:
  // a zone is a directory glob, so "may import the runtime" (an npm package) stays the vendor
  // gate's text scan. `allowTypeOnly` is deliberately absent: a type-only crossing is still a
  // dependency (#145's rule).
  "boundaries": {
    "zones": [
      { "name": "core", "patterns": ["packages/core/src/**"] },
      { "name": "harness-core", "patterns": ["packages/harness/core/**"] },
      { "name": "harness-extensions", "patterns": ["packages/harness/extensions/**"] },
      { "name": "host", "patterns": ["packages/web/src/host/**"] },
      { "name": "server", "patterns": ["packages/web/src/server/**"] },
      { "name": "browser", "patterns": ["packages/web/src/**"] },
      { "name": "site-base", "patterns": ["scripts/docs/site-base.ts"] },
      { "name": "scripts", "patterns": ["scripts/**"] },
      { "name": "test", "patterns": ["test/**", "packages/web/e2e/**"] },
      { "name": "site", "patterns": ["site/**"] }
    ],
    "rules": [
      { "from": "core", "allow": [] },
      { "from": "harness-core", "allow": ["core"] },
      { "from": "harness-extensions", "allow": ["core", "harness-core"] },
      { "from": "host", "allow": ["core"] },
      { "from": "server", "allow": ["core", "host"] },
      { "from": "browser", "allow": ["core"] },
      { "from": "scripts", "allow": ["core", "site-base"] },
      // The site is presentation over generated output: it renders Astro and Starlight, and its
      // CONTENT arrives as files `scripts/docs/site-content.ts` writes, never as an import. It
      // may read ONE file — the base path the site is served under, which the projector, the
      // link crawl and Astro must agree on to the character. Three literals would agree until
      // the day it is published elsewhere and then disagree silently: a wrong base yields
      // working HTML whose every link 404s, and a crawl carrying the same wrong literal reports
      // green over it. One import beats a gate comparing two strings.
      //
      // ⚠ THAT FILE IS ITS OWN ZONE, so the permission is the sentence (PR #330 review). Naming
      // `scripts` here would have allowed the site to import any script in the repository while
      // the comment claimed otherwise — a boundary enforced by convention is not a boundary.
      // `site-base` is a one-file zone that may itself import nothing, and `site` may reach only
      // it; `core` stays refused either way — a renderer with opinions about contracts.
      { "from": "site", "allow": ["site-base"] },
      { "from": "site-base", "allow": [] },
      {
        "from": "test",
        "allow": ["core", "harness-core", "harness-extensions", "host", "server", "browser", "scripts"]
      }
    ],
    // Both HTML entries: an `.html` is the bundler's entry, not a module in any zone. The chat
    // page and the debug page (#144 slice 2) are the two, and naming each keeps a third from
    // arriving unremarked. `oxlint.config.ts` is the lint tool's config, loaded by oxlint and by
    // nothing in the program; it reads its lists from `scripts/lint/`, where the tests and doc
    // generators that hold them also read them.
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": ["packages/web/index.html", "packages/web/debug.html", "oxlint.config.ts"]
    },
    // The storage seam (`no-duplicate-paths`): one file constructs the session manager.
    "calls": {
      "forbidden": [
        { "from": "server", "callee": "SessionManager.*" },
        { "from": "browser", "callee": "SessionManager.*" }
      ]
    }
  }
}
