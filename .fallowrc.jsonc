{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // fallow's static graph (#163, #162 workstream 8). Every entry below names a program whose
  // loader fallow cannot see; without it `fallow fix` would remove the guards. The four
  // extension entries are ASSERTED against `packages/harness/package.json` → `pi.extensions`
  // by `test/fallow-config.test.ts`, so the manifest and this list cannot drift apart.
  "entry": [
    // Loaded by the runtime from the harness manifest, never imported by our code.
    "packages/harness/extensions/logging/index.ts",
    "packages/harness/extensions/guards/index.ts",
    "packages/harness/extensions/web-fetch/index.ts",
    "packages/harness/extensions/web-search/index.ts",
    // Loaded by Bun from `packages/web/bunfig.toml` → `plugins`.
    "packages/web/src/server/bun-plugin-strict-binding-workaround.ts",
    // Run directly: `bun scripts/zen-thread.mjs`; not a package.json script.
    "scripts/zen-thread.mjs",
    // Spawned by `test/docs-gate.test.ts` and run by hand: `bun scripts/docs/<name>.ts`.
    "scripts/docs/*.ts"
  ],
  "ignoreDependencies": [
    // Loaded by the runtime from the harness manifest (`pi.extensions`, `pi.themes`).
    "@ladbabynpm/picc-permission-modes",
    "pi-multi-account",
    "@mammothb/pi-tokyonight-storm",
    // Loaded by Bun from `packages/web/bunfig.toml` → `plugins`, and by the dev server's HMR.
    "bun-plugin-tailwind",
    "react-refresh",
    // The runtime's own packages, supplied by it (peer `@earendil-works/pi-coding-agent`);
    // every import site is under the vendor gate's roots or on its allowlist (#145).
    "@earendil-works/pi-ai",
    "@earendil-works/pi-tui"
  ],
  "ignorePatterns": [".inspiration/**", ".local/**", ".zen/**", "dist-types/**"],
  // "Every shape is a schema in @zen/core" (architecture → The shared core) emits a `Static<typeof X>`
  // type for every schema whether or not code names the type; the unnamed ones are still the
  // contract's public surface, not dead code (#175 bucket C). BY NAME, never "*": a genuinely
  // unused core export must still show. A schema whose type gains a consumer leaves this list.
  "ignoreExports": [
    { "file": "packages/core/src/dialog.ts", "exports": ["ZenDialogAnswer"] },
    { "file": "packages/core/src/follow.ts", "exports": ["ZenFollowObservation"] },
    {
      "file": "packages/core/src/observation.ts",
      "exports": [
        "ZenCustomEntry",
        "ZenDialogSettled",
        "ZenMessageStart",
        "ZenPermissionMode",
        "ZenPermissionModeRejected",
        "ZenPromptRejected",
        "ZenQueue",
        "ZenTurnEnd",
        "ZenTurnStart"
      ]
    },
    { "file": "packages/core/src/tool-result.ts", "exports": ["ZenTruncation", "ZenTruncationUnit"] },
    {
      "file": "packages/core/src/transcript.ts",
      "exports": ["ZenTranscriptCustom", "ZenTranscriptMessage", "ZenTranscriptOther", "ZenTranscriptToolResult"]
    },
    { "file": "packages/core/src/web-fetch.ts", "exports": ["WebFetchConfig"] },
    { "file": "packages/core/src/web-search.ts", "exports": ["WebSearchToolParameters"] }
  ],
  // Vendored presentation and shadcn primitives stay IN the graph (their dependencies are real)
  // but their own findings are hidden: biome and coverage already exclude them (#31, #121), and
  // an unused sub-component there is upstream's, kept diffable, not ours to prune.
  "ignoreFindings": ["packages/web/src/components/**"],
  // Clone detection (#174). `semantic` is the mode this repo reads: `mild` (the default) found
  // three groups and 0.29 % by tokens; the same structure under renamed identifiers is 51
  // groups, and that is the repeated shape, so that is the number the baseline holds. Two
  // classes are excluded by decision, each with its reason:
  // - the vendored components, for the reason `ignoreFindings` gives above — dupes has its own
  //   ignore list, so the decision is written twice;
  // - `@zen/core`: "every shape is a schema" (architecture → The shared core) emits a
  //   `Type.Object` + `Static` pair per schema on purpose, and the tool pairs those as clones.
  //   The convention IS the repetition; a real clone in core is found by the reviewer, not here.
  // What stays in the count and is NOT excluded: consecutive metadata rows in the generators,
  // Playwright arrange/act blocks, the dispatcher's route branches — inventory. `threshold` is
  // the ratchet: fallow 3.25's regression baseline carries dead-code categories only, so the
  // duplicated-line percentage is the number that can only fall. Set to today's value after
  // the three folds (4.5 passes, 4.49 fails); lower it when a fold lands, never raise it.
  // Read by the advisory `fallow-audit` job (`.github/workflows/ci.yml`); promote to the gate
  // once it has been red for a real regression once.
  "duplicates": {
    "mode": "semantic",
    "ignore": ["packages/web/src/components/**", "packages/core/src/**"],
    "threshold": 4.5
  },
  // Complexity thresholds for `fallow audit` (the advisory job). CRAP is OFF, not raised: it is
  // cyclomatic × (1 − coverage)³, and fallow can only ESTIMATE coverage here — Bun's LCOV has no
  // function spans for `--coverage`, so every score is `coverage_source: estimated`, and the
  // estimate reads from export references, which a request listener or a generator's
  // `generate()` never has. Every complexity finding the audit raised on #180, #181 and #182
  // was `exceeded: crap` on a function the suite drives; cyclomatic (20) and cognitive (15)
  // never fired and stay on — cognitive is also biome's hard ceiling at 25.
  "health": {
    "maxCrap": 0
  },
  // `error` since the day-one list (five, all `rpc/`, recorded on #173) reached zero: a crossing
  // now fails the dead-code gate step. Coverage and forbidden-call findings share the severity.
  "rules": { "boundary-violation": "error" },
  // Architecture boundaries (#173, #162 workstream 9): the vendor gate and the storage seam read
  // TEXT; this reads the IMPORT GRAPH, and catches what text cannot — a re-export chain, a
  // type-only import, a barrel that leaks a zone. Zones are the TARGET layout of the re-cut,
  // written before the tree matches it; the violation list is the move list. What it cannot say:
  // a zone is a directory glob, so "may import the runtime" (an npm package) stays the vendor
  // gate's text scan. `allowTypeOnly` is deliberately absent: a type-only crossing is still a
  // dependency (#145's rule).
  "boundaries": {
    "zones": [
      { "name": "core", "patterns": ["packages/core/src/**"] },
      { "name": "harness-core", "patterns": ["packages/harness/core/**"] },
      { "name": "harness-extensions", "patterns": ["packages/harness/extensions/**"] },
      { "name": "host", "patterns": ["packages/web/src/host/**"] },
      { "name": "server", "patterns": ["packages/web/src/server/**"] },
      { "name": "browser", "patterns": ["packages/web/src/**"] },
      { "name": "scripts", "patterns": ["scripts/**"] },
      { "name": "test", "patterns": ["test/**", "packages/web/e2e/**"] }
    ],
    "rules": [
      { "from": "core", "allow": [] },
      { "from": "harness-core", "allow": ["core"] },
      { "from": "harness-extensions", "allow": ["core", "harness-core"] },
      { "from": "host", "allow": ["core"] },
      { "from": "server", "allow": ["core", "host"] },
      { "from": "browser", "allow": ["core"] },
      { "from": "scripts", "allow": ["core"] },
      {
        "from": "test",
        "allow": ["core", "harness-core", "harness-extensions", "host", "server", "browser", "scripts"]
      }
    ],
    "coverage": { "requireAllFiles": true, "allowUnmatched": ["packages/web/index.html"] },
    // The storage seam (`no-duplicate-paths`): one file constructs the session manager.
    "calls": {
      "forbidden": [
        { "from": "server", "callee": "SessionManager.*" },
        { "from": "browser", "callee": "SessionManager.*" }
      ]
    }
  }
}
