{
  "name": "enso-foundation",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "typecheck": "tsc -b --pretty false --checkers 4",
    "deadcode:check": "fallow dead-code --quiet",
    "test": "bun test",
    "lint": "bun --bun oxlint",
    "lint:fix": "bun --bun oxlint --fix",
    "format": "bun --bun oxfmt",
    "check:all": "bun scripts/gate.ts",
    "check": "bun scripts/gate.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "link:vendor": "bun scripts/link-vendor-packages.ts",
    "postinstall": "bun scripts/link-vendor-packages.ts",
    "enso": "bun scripts/enso.ts",
    "dev": "bun scripts/dev.ts",
    "logs": "bun scripts/enso-logs.ts",
    "eval": "bun scripts/enso-eval.ts",
    "incidents": "bun scripts/enso-incidents.ts",
    "judge": "bun scripts/enso-judge.ts",
    "corpus": "bun scripts/enso-corpus.ts",
    "review": "bun scripts/review/review-pr.ts",
    "review-notify": "bun scripts/review/review-notify.ts",
    "review-status": "bun scripts/review/review-status.ts",
    "review-worker": "bun scripts/review/review-worker.ts",
    "dev:server": "bun run --silent --cwd packages/web dev:server",
    "dev:web": "bun run --silent --cwd packages/web dev:web",
    "e2e": "bunx playwright test --config packages/web/e2e/playwright.config.ts --grep-invert @model",
    "e2e:model": "ENSO_E2E_MODEL=1 bunx playwright test --config packages/web/e2e/playwright.config.ts --grep @model",
    "coverage:check": "bun scripts/check-coverage.ts",
    "coverage:istanbul": "bun scripts/coverage-istanbul.ts",
    "doctor": "bunx react-doctor --verbose",
    "doctor:check": "react-doctor --project packages/web --scope full --no-score --no-supply-chain --blocking warning",
    "docs:api": "typedoc --emit none",
    "docs:build": "bun scripts/docs/build-docs.ts",
    "docs:site": "bun scripts/docs/build-docs.ts && bun scripts/docs/site-content.ts && bunx astro build --root site && bun scripts/docs/site-links.ts",
    "docs:screenshots": "bun scripts/docs/feature-screenshots.ts",
    "docs:social-card": "bun scripts/docs/social-card.ts",
    "format:check": "bun --bun oxfmt --check",
    "complexity:check": "fallow health --complexity --max-cognitive 20 --max-cyclomatic 1000 --quiet",
    "complexity:new": "fallow health --complexity --max-cognitive 15 --max-cyclomatic 1000 --quiet --baseline complexity-baseline.json --baseline-mode identity --fail-on-stale-baseline",
    "complexity:baseline": "fallow health --complexity --max-cognitive 15 --max-cyclomatic 1000 --quiet --save-baseline complexity-baseline.json --baseline-mode identity; bun --bun oxfmt complexity-baseline.json",
    "dupes:check": "fallow dupes --quiet --summary",
    "health:full": "bun scripts/health-full.ts",
    "crap:check": "bun scripts/coverage-istanbul.ts && bun scripts/check-crap.ts"
  },
  "devDependencies": {
    "@enso/core": "*",
    "@enso/test-support": "*",
    "@happy-dom/global-registrator": "20.14.5",
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.4.2",
    "@typescript/native": "npm:typescript@~7.0.2",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-unicorn": "76.0.0",
    "fallow": "3.33.0",
    "mermaid": "^12.0.0",
    "oxc-parser": "0.148.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "react-doctor": "0.9.14",
    "typedoc": "0.28.20",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  },
  "overrides": {
    "@tanstack/ai": "0.66.0",
    "@tanstack/ai-client": "0.39.0",
    "@tanstack/ai-react": "0.30.1",
    "@tanstack/react-virtual": "3.14.13",
    "@ag-ui/core": "1.0.0"
  }
}
