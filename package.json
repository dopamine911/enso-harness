{
	"name": "zen-harness-foundation",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=22"
	},
	"packageManager": "bun@1.4.0",
	"scripts": {
		"typecheck": "tsc -b --pretty false",
		"test": "bun test",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"check:all": "bun scripts/gate.ts",
		"check": "bun scripts/gate.ts",
		"prepare": "git config core.hooksPath .githooks || true",
		"link:vendor": "bun scripts/link-vendor-packages.mjs",
		"postinstall": "bun scripts/link-vendor-packages.mjs",
		"zen": "bun scripts/zen.mjs",
		"dev": "bun scripts/dev.mjs",
		"dev:server": "bun run --silent --cwd packages/web dev:server",
		"dev:web": "bun run --silent --cwd packages/web dev:web"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/bun": "^1.4.0",
		"typescript": "^5.7.0"
	},
	"overrides": {
		"@tanstack/ai": "0.53.0",
		"@tanstack/ai-client": "0.31.0",
		"@tanstack/ai-utils": "0.4.0",
		"@ag-ui/core": "0.1.1-canary.beta.0"
	}
}
