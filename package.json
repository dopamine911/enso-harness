{
  "name": "zen-harness-foundation",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "deadcode:check": "fallow dead-code --quiet --baseline fallow-baseline.json",
    "deadcode:baseline": "fallow dead-code --quiet --save-baseline fallow-baseline.json",
    "test": "bun test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "check:all": "bun scripts/gate.ts",
    "check": "bun scripts/gate.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "link:vendor": "bun scripts/link-vendor-packages.ts",
    "postinstall": "bun scripts/link-vendor-packages.ts",
    "zen": "bun scripts/zen.ts",
    "dev": "bun scripts/dev.ts",
    "logs": "bun scripts/zen-logs.ts",
    "dev:server": "bun run --silent --cwd packages/web dev:server",
    "dev:web": "bun run --silent --cwd packages/web dev:web",
    "e2e": "bunx playwright test --config packages/web/e2e/playwright.config.ts --grep-invert @model",
    "e2e:model": "bunx playwright test --config packages/web/e2e/playwright.config.ts --grep @model",
    "coverage:check": "bun scripts/check-coverage.ts",
    "doctor": "bunx react-doctor --verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.0",
    "fallow": "3.25.0",
    "react-doctor": "0.9.14",
    "typedoc": "0.28.20",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@tanstack/ai": "0.53.0",
    "@tanstack/ai-client": "0.31.0",
    "@tanstack/ai-react": "0.24.0",
    "@ag-ui/core": "0.1.1-canary.beta.0"
  }
}
