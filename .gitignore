node_modules/
dist-types/
.enso/
.local/
.inspiration/

# pi's session exports, written to the cwd on demand — artifacts, not sources
pi-session-*.html
.codegraph/
coverage/
.env
# Playwright smoke output — screenshots and traces the PR author drags in by hand (#71)
packages/web/e2e/output/

# Playwright MCP session artifacts (snapshots/console logs the browser plugin writes into the cwd)
.playwright-mcp/

# fallow viz output (`bunx fallow viz`) — a local map, regenerated on demand
fallow-viz.html

# The site is a build product of `docs/` and TypeDoc, never an editable copy (#188).
site/src/content/docs/
site/dist/
site/.astro/

# Docs pages that are BUILD OUTPUT (#482), written by `bun run docs:build` and the site build:
# reference pages from their generators, flow pages from tags in source and the diagrams tests
# record. Edit the source; a page here is overwritten on every build. The list is
# `scripts/docs/build-docs.ts#builtDocPages`; `test/docs-gate.test.ts` holds this file to it.
docs/reference/*.md
!docs/reference/README.md
docs/seams/ported-provenance.md
docs/flows/*.md
!docs/flows/README.md
# Features pages, each built from its spec (`scripts/docs/features/index.ts`) and its captured facts.
docs/features/*.md
!docs/features/README.md

# Built by CI for the reviewer (`scripts/docs/touched-comments.ts`, #482); a local run writes it wherever `--out` says.
.claude/touched-comments.md
