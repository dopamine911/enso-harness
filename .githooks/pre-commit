#!/bin/sh
# Pre-commit gate (#807): runs `check:all`, the single source of "green" (scripts/gate.ts; the same
# gate CI runs), over the working tree as it is — commit with nothing in the tree you do not mean to
# commit. Wired via core.hooksPath, set by the package.json `prepare` script on install. For a
# deliberate work-in-progress commit, bypass with `git commit --no-verify`.
#
# Git runs hooks from the repo root, which is where package.json lives, so `run check:all` resolves
# without changing directory.
#
# The package manager is read off the committed lockfile: the repo commits exactly one and
# gitignores the others. npm is the fallback so that a tree with no lockfile yet — a fresh
# `git init` before the first install — still gets a comprehensible failure from the gate itself.
set -e

if [ -f bun.lock ] || [ -f bun.lockb ]; then
  bun run check:all
elif [ -f pnpm-lock.yaml ]; then
  pnpm run check:all
else
  npm run check:all
fi
