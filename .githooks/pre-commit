#!/bin/sh
# Pre-commit gate — runs the full check:all (oxfmt + oxlint + tsc -b + fallow + bun test + the
# coverage floor + the docs), the single source of "green" (scripts/gate.ts). Wired via core.hooksPath, set by the
# package.json `prepare` script on install. For a deliberate work-in-progress commit, bypass with
# `git commit --no-verify`.
#
# Git runs hooks from the repo root, which is where package.json lives, so `run check:all` resolves
# without changing directory.
#
# WHAT THE GATE IS RUN OVER — the guarantee, and where it stops. It ran over the WORKING TREE, so a
# partial commit (`git add -p`, or staged changes sitting alongside unstaged ones) was validated
# against content that is not what gets committed: green locally, red in CI, which is precisely the
# claim this hook makes and the case a WIP-discipline repo hits most. Measured 2026-09-18 with a
# throwaway repo whose gate printed the file it saw: index `STAGED`, working tree `DIRTY`, the gate
# read `DIRTY` and the commit contained `STAGED`. So the unstaged remainder is now stashed for the
# duration of the run and restored afterwards, and the gate sees the snapshot being committed.
#
# WHEN IT DOES NOT ISOLATE, and why that is right rather than a gap. `git commit -a` and
# `git commit -- <path>` hand the hook a TEMPORARY index (`GIT_INDEX_FILE` pointed at
# `.git/index.lock` and `.git/next-index-*.lock` respectively — measured the same day); stashing
# would operate on that temporary snapshot, not on the developer's. For `-a` the working tree IS
# what is being committed, so running over it is correct. For a path-limited commit it is a
# superset, so the gate is stricter than the commit, never looser. Isolation therefore runs only
# when the hook holds the real index, and the run says which mode it took.
#
# RECOVERY. The stash is a normal stash entry with a named message, not a detached object: if the
# automatic restore ever fails, the working tree is one `git stash apply --index <sha>` away, and the
# hook prints that command, with the sha, rather than leaving you to guess. Ignored paths
# (`coverage/`, `dist-types/`) are never stashed, so the gate's own output is untouched by any of this.
#
# WHY THE MANAGER IS DETECTED RATHER THAN NAMED. This file is copied VERBATIM into the generated
# project — it is not a template — so the package manager cannot be interpolated into it. Hardcoding
# `npm` was the previous behaviour and it was wrong two ways: on a Bun-only machine the hook died with
# "npm: not found", and in a pnpm project it ran npm against a pnpm-installed tree.
#
# The lockfile is a RELIABLE signal here rather than a guess: this project commits exactly one
# lockfile and gitignores every other manager's. That invariant is enforced by .gitignore and asserted
# by the factory's generation tests, so the committed lockfile identifies the manager unambiguously.
#
# npm is the fallback rather than a hard error so that a tree with no lockfile yet — a fresh
# `git init` before the first install — still gets a comprehensible failure from the gate itself.
set -e

run_gate() {
  if [ -f bun.lock ] || [ -f bun.lockb ]; then
    bun run check:all
  elif [ -f pnpm-lock.yaml ]; then
    pnpm run check:all
  else
    npm run check:all
  fi
}

# The hook holds the developer's own index only when GIT_INDEX_FILE is unset or names `index`.
# Git's temporary indexes are `index.lock` (`commit -a`) and `next-index-<pid>.lock` (a
# path-limited commit); see WHEN IT DOES NOT ISOLATE above. Match on the FILE NAME, not on a path
# comparison against `git rev-parse --git-path index` — that command honours GIT_INDEX_FILE and
# echoes the override straight back, so the comparison can never fail (measured 2026-09-18: it
# reported `.git/index.lock` as the real index during `git commit -a`).
index_name="${GIT_INDEX_FILE##*/}"
if [ -n "${index_name}" ] && [ "${index_name}" != 'index' ]; then
  echo "pre-commit: gating the working tree — git built a temporary index (${index_name}) for this commit."
  run_gate
  exit 0
fi

# ⚠ …and never during a MERGE, cherry-pick or revert. Measured on this branch: the isolation
# below ends in `git reset --hard`, which deletes `.git/MERGE_HEAD`, and the commit then dies
# with `could not open …/MERGE_HEAD` — leaving a resolved merge staged and unrecorded, which
# is the one state where a developer's work is hardest to reconstruct. Nothing is given up by
# skipping: in these states the working tree IS the resolution being committed, so gating it
# is exact rather than a compromise.
for in_progress in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  if git rev-parse -q --verify "${in_progress}" >/dev/null 2>&1; then
    echo "pre-commit: gating the working tree — ${in_progress} is in progress, and isolating would discard it."
    run_gate
    exit 0
  fi
done

# ⚠ ONE HOOK AT A TIME ACROSS WORKTREES, AND THE STASH BY ITS SHA. `refs/stash` is shared by every
# worktree of a repository. Measured 2026-10-07, four worktrees committing at once: one hook popped
# another's `stash@{0}` into its own tree and committed it, and one took another's push for its own
# (`stash_before` ≠ `stash_after`). So the stash section — push, gate, pop — holds a lock in the
# COMMON git dir, and the restore applies and drops the entry it pushed, by sha, never `stash@{0}`.
# A lock whose holder is gone (a hook killed mid-run) is taken over; a live one is waited for.
lock="$(git rev-parse --git-common-dir)/pre-commit-gate.lock"
release_lock() {
  rm -rf "${lock}"
}
waited=0
until mkdir "${lock}" 2>/dev/null; do
  holder=$(cat "${lock}/pid" 2>/dev/null || true)
  if [ -n "${holder}" ] && ! kill -0 "${holder}" 2>/dev/null; then
    echo "pre-commit: the gate lock's holder (pid ${holder}) is gone; taking the lock over."
    rm -rf "${lock}"
    continue
  fi
  if [ "${waited}" -eq 0 ]; then echo "pre-commit: another worktree's commit is being gated; waiting for it."; fi
  waited=$((waited + 1))
  sleep 2
done
echo $$ >"${lock}/pid"

stash_message="pre-commit gate: unstaged remainder, restored automatically"
stash_before=$(git rev-parse -q --verify refs/stash || true)
git stash push --keep-index --include-untracked --quiet --message "${stash_message}" || {
  release_lock
  exit 1
}
stash_after=$(git rev-parse -q --verify refs/stash || true)

# Compare the ref, never `git stash list`: with nothing unstaged to save, `stash push` succeeds and
# creates NOTHING, and a restore that assumed otherwise would pop a stash the developer made
# earlier and call it cleanup. Nothing stashed, nothing to hold the lock for.
if [ "${stash_before}" = "${stash_after}" ]; then
  release_lock
  run_gate
  exit 0
fi

# Drop the entry holding this sha, wherever it now sits: a developer's own `git stash` in another
# worktree, during the gate, may have pushed above it.
drop_by_sha() {
  git stash list --format='%gd %H' | while read -r entry sha; do
    if [ "${sha}" = "${stash_after}" ]; then
      git stash drop --quiet "${entry}"
      break
    fi
  done
}

restore() {
  status=$?
  trap - EXIT INT TERM HUP
  # `reset --hard` first: applying the stash puts a diff against HEAD, and after --keep-index the
  # working tree already carries the staged half of it, so applying straight onto it conflicts on
  # exactly the files a partial commit touches. Resetting to HEAD is the state the stash was taken
  # from. Nothing is lost by it — every change, staged and unstaged, is inside the stash entry, and
  # `apply --index` puts both halves back where they were. Ignored build output is not touched.
  if git reset --hard --quiet && git stash apply --index --quiet "${stash_after}"; then
    drop_by_sha
    release_lock
    exit "${status}"
  fi
  release_lock
  echo "pre-commit: could not restore your working tree automatically." >&2
  echo "pre-commit: nothing is lost — your changes are the stash entry ${stash_after}:" >&2
  echo "pre-commit:   git stash apply --index ${stash_after}   # \"${stash_message}\"" >&2
  exit 1
}
trap restore EXIT INT TERM HUP

run_gate
