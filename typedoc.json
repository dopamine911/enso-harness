{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "packages/core/src/index.ts",
    "packages/core/src/paths.ts",
    "packages/core/src/secrets.ts",
    "packages/core/src/pi-manifest.ts",
    "packages/core/src/log-process.ts",
    "packages/harness/core/index.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "name": "zen-harness — owned contracts",
  "readme": "none",
  "useFirstParagraphOfCommentAsSummary": true,
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "skipErrorChecking": true,
  "gitRevision": "main",
  "categorizeByGroup": true,
  "categoryOrder": [
    "Message stream",
    "Tool calls",
    "Turns and cost",
    "Prompt admission",
    "Permission and dialogs",
    "Extension surface",
    "The union",
    "*"
  ],
  "groupOrder": [
    "Configuration",
    "Observations",
    "Follow wire",
    "Transcript",
    "Thread runtime",
    "Thread inspection",
    "Dialogs",
    "Permission mode",
    "Tool results",
    "Web tools",
    "Web search",
    "Web fetch policy",
    "Guards",
    "Guard predicates",
    "Deadlines",
    "Workspace paths",
    "Secrets",
    "pi manifest",
    "Logging",
    "*"
  ],
  "disableSources": false,
  "hideGenerator": true
}
