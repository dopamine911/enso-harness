{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "packages/core/src/index.ts",
    "packages/core/src/git.ts",
    "packages/core/src/paths.ts",
    "packages/core/src/permission-rules.ts",
    "packages/core/src/secrets.ts",
    "packages/core/src/pi-manifest.ts",
    "packages/core/src/log-process.ts",
    "packages/harness/core/index.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "name": "Enso — owned contracts",
  "readme": "none",
  "useFirstParagraphOfCommentAsSummary": true,
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "skipErrorChecking": true,
  "gitRevision": "main",
  "categorizeByGroup": true,
  "categoryOrder": [
    "Message stream",
    "Tool calls",
    "Turns and cost",
    "Prompt admission",
    "Permission and dialogs",
    "Extension surface",
    "The union",
    "*"
  ],
  "groupOrder": [
    "Configuration",
    "Observations",
    "Follow wire",
    "Transcript",
    "Thread runtime",
    "Thread inspection",
    "Thread stats",
    "Thread context",
    "Run context",
    "Git",
    "Session eval",
    "Session risk",
    "Session incident",
    "Incident report",
    "Dialogs",
    "Permission mode",
    "Permission policy",
    "Projects",
    "Prompt library",
    "Tool results",
    "Web tools",
    "Web search",
    "Web fetch policy",
    "Guards",
    "Guard predicates",
    "Project trust",
    "Deadlines",
    "Workspace paths",
    "Secrets",
    "pi manifest",
    "Logging",
    "*"
  ],
  "disableSources": false,
  "hideGenerator": true
}
